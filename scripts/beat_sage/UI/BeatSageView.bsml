    <modal id='unsaved-modal' size-delta-x='134' size-delta-y='39' clickerino-offerino-closerino='false'>
      <vertical pad='3' spacing='2' background='round-rect-panel' bg-color='#101E31FA' child-control-width='true' child-expand-width='false'>
        <text text='~unsaved-title' align='Center' font-size='3.6' preferred-height='7'/>
        <text text='~error' active='~has-error' align='Center' font-size='3.2' preferred-height='6' word-wrapping='true'/>
        <horizontal preferred-height='8' spacing='2' child-align='MiddleCenter' child-control-width='true' child-expand-width='false'>
          <button text='~continue-editing-label' on-click='continue-editing' font-size='3.2' pref-width='48' pref-height='8'/>
          <button text='~discard-and-leave-label' on-click='discard-and-leave' font-size='3.2' pref-width='34' pref-height='8'/>
          <primary-button text='~save-and-leave-label' on-click='save-and-leave' font-size='3.2' pref-width='38' pref-height='8'/>
        </horizontal>
      </vertical>
    </modal>
    <modal id='choice-modal' size-delta-x='92' size-delta-y='58' clickerino-offerino-closerino='false'>
      <vertical pad='3' spacing='2' background='round-rect-panel' bg-color='#101E31FA' child-control-width='true' child-expand-width='false'>
        <text text='~choice-title' rich-text='false' align='Center' font-size='3.2' bold='true' preferred-height='5' overflow-mode='Ellipsis' word-wrapping='false'/>
        <list id='choice-list' preferred-width='76' min-width='0' list-width='76' pref-height='36' cell-size='6' visible-cells='6' select-cell='choice-select' show-scrollbar='true' stick-scrolling='true'/>
        <button text='~caption-back' on-click='close-choices' font-size='2.8' pref-width='86' pref-height='6'/>
      </vertical>
    </modal>
    <modal id='song-editor-modal' show-event='show-song-editor' hide-event='close-song-editor' clickerino-offerino-closerino='false' size-delta-x='112' size-delta-y='48'>
      <vertical spacing='2' pad='3' background='round-rect-panel'>
        <text text='~caption-song-metadata' align='Center' font-size='3.5' bold='true'/>
        <string-setting text='~caption-title' value='song-title' apply-on-change='true' bind-value='true' min-width='0' preferred-height='7'/>
        <string-setting text='~caption-artist' value='song-artist' apply-on-change='true' bind-value='true' min-width='0' preferred-height='7'/>
        <horizontal spacing='1' child-expand-width='false' child-control-width='true'>
          <string-setting text='~caption-cover-path' value='song-cover-path' apply-on-change='true' bind-value='true' min-width='0' preferred-width='78' preferred-height='7'/>
          <button text='~caption-choose-cover' on-click='choose-cover' font-size='2.6' pref-width='26' pref-height='6'/>
        </horizontal>
        <button text='~caption-back' on-click='close-song-editor' font-size='2.8' pref-width='106' pref-height='6'/>
      </vertical>
    </modal>
    <modal id='retry-modal' show-event='show-retry' hide-event='close-retry' clickerino-offerino-closerino='false' size-delta-x='76' size-delta-y='32'>
      <vertical spacing='2' pad='3'>
        <text text='~retry-title' align='Center' font-size='3.2'/>
        <text text='~caption-the-upload-result-is-unknown-resubmit' font-size='2.7' align='Center' word-wrapping='true'/>
        <horizontal spacing='2' child-align='MiddleCenter'>
          <button text='~caption-cancel' on-click='close-retry' font-size='2.7' pref-width='31' pref-height='7'/>
          <primary-button text='~caption-confirm-retry' on-click='confirm-retry' font-size='2.7' pref-width='31' pref-height='8'/>
        </horizontal>
      </vertical>
    </modal>
  </vertical>
</bg>
