          ],
          "environment": "DefaultEnvironment"
        }
      }
    ],
    "jobs": [],
    "notice": "",
    "importBlocked": false,
    "retryAfterUtc": ""
  },
  "x-environments": [
    {
      "value": "DefaultEnvironment",
      "gameName": "DefaultEnvironment"
    },
    {
